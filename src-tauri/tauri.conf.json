{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ce-git",
  "version": "1.0.40",
  "identifier": "com.ce.git",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ce-git",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBNURGQzBBMkZGMEZDMUMKUldRYy9QQXZDdnhkV3NvdWU1eXV6cWRpQVQ5Y2tDMUdCSTNla3NNUWtxS3pyUnh1Q0FSTDlpY3UK",
      "endpoints": [
        "https://github.com/CHE-11/ce-git/releases/latest/download/latest.json"
      ]
    }
  }
}
